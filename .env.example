# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# --- API server ---
# Port the Fastify API listens on.
API_PORT=3000
# Host to bind. 0.0.0.0 inside containers, 127.0.0.1 for local-only.
API_HOST=0.0.0.0
# Public origin of the web app, used for CORS + cookie settings.
# Behind the caddy TLS proxy, set this to your HTTPS site, e.g.
# https://your-mac.local
APP_ORIGIN=http://localhost:5173

# --- HTTPS reverse proxy (docker compose `caddy` service) ---
# Hostname Caddy serves. LAN: use your Mac's Bonjour name so Apple devices
# resolve it with no DNS (e.g. Chriss-MacBook-Pro.local); Caddy signs it with
# its internal CA. A public domain here switches Caddy to Let's Encrypt (see
# docker/Caddyfile).
SITE_ADDRESS=your-mac.local

# Public base URL of this instance (scheme + host, no trailing slash), used
# for absolute links on public share pages and their feeds. Optional; when
# unset, public pages derive it from the request.
# PUBLIC_URL=https://reader.example.com

# --- Database ---
# Full connection string used by the API and drizzle-kit.
DATABASE_URL=postgres://rss:rss@localhost:5432/rss

# Individual parts (used by docker-compose to provision Postgres).
POSTGRES_USER=rss
POSTGRES_PASSWORD=rss
POSTGRES_DB=rss

# --- Auth ---
# 32+ byte random secret for signing session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- Feed worker ---
# How often the worker wakes to check for due feeds (seconds). This gates the
# shortest effective per-feed interval, so keep it small.
FEED_POLL_INTERVAL_SEC=60
# Max feeds fetched concurrently by the worker.
FEED_POLL_CONCURRENCY=8

# --- Web (build-time, prefixed VITE_) ---
# Base URL the browser uses to reach the API. Empty = same origin (prod).
VITE_API_BASE_URL=
